# Single source of truth for compose AND local terminal runs.
# NOTE: DATABASE_URL is intentionally NOT stored here.
# - compose builds it with @db:5432 (see ops/docker-compose.yml)
# - ops/Load-Env.ps1 derives the local variant with @localhost:5434
POSTGRES_PASSWORD=change-me
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/meta/oauth/callback
META_GRAPH_VERSION=v26.0
META_ALLOWED_RETURN_URIS=http://localhost:3000/callback,dojo://callback
META_TOKEN_ENCRYPTION_KEY=
META_OAUTH_SCOPE=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement
