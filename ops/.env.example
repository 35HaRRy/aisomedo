# Single source of truth for compose AND local terminal runs.
# NOTE: DATABASE_URL is intentionally NOT stored here.
# - compose builds it with @db:5432 (see ops/docker-compose.yml)
# - ops/Load-Env.ps1 derives the local variant with @localhost:5434
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dojo
POSTGRES_USER=dojo
# Public origin (browser access, OAuth callbacks, signed artifact URLs).
# PUBLIC_HTTPS_ORIGIN wins when set and MUST be https in prod; it falls back
# to PUBLIC_BASE_URL when empty. Keep both on the same public origin.
DOMAIN=example.com
PUBLIC_BASE_URL=https://example.com
PUBLIC_HTTPS_ORIGIN=https://example.com
SIGNED_URL_SECRET=change-me
COOKIE_SECURE=true
# Gateway: loopback HTTP port for existing-proxy mode; external Docker network
# name when joining a container-based upstream proxy (uncomment block in
# ops/docker-compose.existing-proxy.yml). Caddy trusts forwarded client/scheme
# headers only from these addresses/networks.
GATEWAY_HTTP_PORT=9080
EXTERNAL_NETWORK_NAME=
TRUSTED_PROXIES=private_ranges
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://example.com/api/meta/oauth/callback
META_GRAPH_VERSION=v26.0
META_ALLOWED_RETURN_URIS=https://example.com/callback,dojo://callback
META_TOKEN_ENCRYPTION_KEY=
META_OAUTH_SCOPE=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement
MEDIA_ROOT=
# Worker tick interval. WORKER_HEALTH_IDLE_SECONDS (120) must exceed it, or a
# healthy loop looks stale between turns.
WORKER_INTERVAL_SECONDS=10
# Operational alerts (ops/docker-compose.monitoring.yml). Nothing below is read
# by the base production file: without that override no alert is ever sent and
# no credential is needed, so CI can render the base config with this example
# file alone.
#
# BOTH values below are required when the monitoring override is used. Compose
# fails the render when either is unset, so a mistake is a fixable message
# rather than a worker that crash-loops on every start. The base production
# file reads neither.
#
# FCM_CREDENTIALS_FILE is the ONLY way to point the worker at Firebase: an
# absolute host path to a service account JSON, mounted read-only at
# /run/secrets/firebase-credentials.json. Never commit the file itself.
# FCM_PROJECT_ID names the Firebase project. FCM addresses by project, so a
# notifier that cannot name one would fail every send (or worse, address
# whichever project the credential happens to name). GOOGLE_CLOUD_PROJECT is
# read as a fallback, but set this one explicitly.
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
# Disk monitoring. All optional; the defaults shown are the values the worker
# already uses when these are unset. MONITORING_DISK_PATHS is a JSON object of
# target name to absolute in-container path and REPLACES the default
# {"media":"/media","root":"/"} pair, so it must repeat every target you still
# want. See docs/rehberler/production-monitoring.md before changing it: the
# default pair cannot see a host filesystem that is not the container's, and
# that pair reports the Docker data root rather than the named volume.
MONITORING_INTERVAL_SECONDS=60
MONITORING_DISK_LOW_PERCENT=15
MONITORING_DISK_RECOVERY_PERCENT=20
MONITORING_DISK_PATHS=
